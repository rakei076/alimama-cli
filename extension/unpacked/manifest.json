{
  "manifest_version": 3,
  "name": "taobao-cli 取数桥",
  "short_name": "taobao-cli",
  "version": "0.8.0",
  "description": "让你电脑上的店铺数据工具借用浏览器里已登录的淘宝、天猫卖家后台读取数据，并能在多个账号之间一键切换。只读，数据只交给本机，不上传。",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "alarms",
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.tmall.hk/*",
    "https://*.alimama.com/*",
    "https://passport.alibaba.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dmp.taobao.com/*",
        "https://myseller.taobao.com/*",
        "https://sycm.taobao.com/*",
        "https://one.alimama.com/*",
        "https://item.taobao.com/*",
        "https://www.taobao.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "taobao-cli 取数桥",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}